APP_ENV=development
LOG_LEVEL=INFO

CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=75
TOKENIZER_STRATEGY=regex_v1

MODEL_CACHE_DIR=.cache/huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=opsrag_documents
QDRANT_TIMEOUT_SECONDS=10
QDRANT_BATCH_SIZE=64
TOP_K_DENSE=10
TOP_K_SPARSE=10
TOP_K_HYBRID=10
TOP_K_RERANK=5
RRF_K=60
PROCESSED_CHUNKS_PATH=data/processed/chunks.jsonl

LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=800
OLLAMA_BASE_URL=http://localhost:11434

RAGAS_JUDGE_PROVIDER=
RAGAS_JUDGE_MODEL=
RAGAS_CACHE_DIR=.cache/ragas
RAGAS_TIMEOUT_SECONDS=60
RAGAS_MAX_RETRIES=3
RAGAS_MAX_OUTPUT_TOKENS=512

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0

OPSRAG_API_BASE_URL=http://localhost:8000
OPSRAG_API_TIMEOUT_SECONDS=300
